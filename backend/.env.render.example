# Referência para Render. O render.yaml já cria a maior parte destas variáveis.
# DATABASE_URL: use a Session Pooler URL do Supabase (porta 5432), com SSL.
NODE_ENV=production
HOST=0.0.0.0
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.pooler.supabase.com:5432/postgres?sslmode=require
FRONTEND_URL=https://SEU-DASHBOARD.vercel.app
JWT_SECRET=GERADO_PELO_RENDER
JWT_REFRESH_SECRET=GERADO_PELO_RENDER
IA_API_KEY=GERADO_PELO_RENDER_E_COMPARTILHADO_COM_PYTHON
PYTHON_INTERNAL_HOSTPORT=CONFIGURADO_PELO_RENDER_BLUEPRINT
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
IA_MIN_CONFIDENCE_SCORE=0.70
TRUST_PROXY_HOPS=1
ALLOW_LOCAL_CORS=false
ENABLE_API_DOCS=false
