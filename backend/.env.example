# Copie para .env e altere os valores antes de iniciar o backend.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Dashboard React e outros frontends web permitidos, separados por vírgula.
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Banco PostgreSQL / Prisma
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/tcc_presenca?schema=public"

# JWT - use segredos diferentes, longos e aleatórios.
JWT_SECRET=TROQUE_POR_UMA_CHAVE_LONGA_DE_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_CHAVE_LONGA_DE_PELO_MENOS_32_CARACTERES
JWT_REFRESH_EXPIRES_IN=7d

# Python / reconhecimento facial
PYTHON_API_URL=http://localhost:5000
IA_API_KEY=TROQUE_POR_UMA_CHAVE_SERVER_TO_SERVER_LONGA
IA_MIN_CONFIDENCE_SCORE=0.70
IA_RATE_LIMIT_MAX=120
SECOND_FACTOR_RATE_LIMIT_MAX=8

# Limites HTTP
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
TRUST_PROXY_HOPS=0
ALLOW_LOCAL_CORS=true
ENABLE_API_DOCS=true
AUTH_RATE_LIMIT_MAX=20

# Alertas / retenção
FREQUENCIA_MINIMA_PERCENTUAL=75
AUDIT_RETENTION_DAYS=180

# SMTP é opcional. Sem ele, recuperação de senha por e-mail e relatórios
# automáticos por e-mail ficam indisponíveis, mas a API principal inicia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_COZINHA=
EMAIL_SECRETARIA=
EMAIL_DIRETORIA=

# Credenciais apenas para seed/demonstração local. Troque antes de qualquer uso real.
SEED_ADMIN_EMAIL=admin@senai.br
SEED_ADMIN_PASSWORD=Admin@2026
SEED_DEFAULT_PASSWORD=Senai@2026
SEED_RESET_PASSWORDS=false
